# Production env for infra/docker-compose.prod.yml — copy to infra/prod.env
# (gitignored) and fill in real values. Generate secrets:
#   openssl rand -base64 32

# Postgres superuser password (also used by Temporal persistence).
POSTGRES_PASSWORD=

# Public origins — the browser-facing web URL and the API URL it calls.
WEB_ORIGIN=https://app.example.com
BETTER_AUTH_URL=https://api.example.com
NEXT_PUBLIC_SERVER_URL=https://api.example.com

# Secrets — production refuses the baked-in dev defaults.
BETTER_AUTH_SECRET=
PLATFORM_ENCRYPTION_KEY=

# Optional: Google OAuth (enabled only when both are present).
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
