# Conductor — environment variables (copy to .env; never commit real secrets)

# --- Ports ---
WEB_PORT=3000
SERVER_PORT=4000

# --- PostgreSQL (app database; Temporal uses its own DB on the same server) ---
# Used by apps/server and apps/worker (Drizzle). Local dev points at docker compose.
DATABASE_URL=postgresql://conductor:conductor@localhost:5432/conductor

# --- Redis (ephemeral pub/sub for live step status + LLM token streams) ---
REDIS_URL=redis://localhost:6379

# --- Temporal (durable execution) ---
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
# Task queue override (Unit 23) — defaults to the shared constant. Set the
# SAME value on server and worker. The golden-path E2E uses "conductor-e2e"
# so a stale dev worker can never steal its activities.
# TEMPORAL_TASK_QUEUE=conductor-content

# --- AI (agent LLM calls via OpenRouter + Vercel AI SDK) ---
# Since Unit 12 there is NO platform OpenRouter key: agents run on the org's
# key, stored encrypted (org_api_keys) and decrypted only inside worker
# activities at call time. Owners set it via PUT /orgs/api-key.
# OpenRouter model slug for the research agent (Unit 05). Writing uses its own in Unit 06.
RESEARCH_MODEL=anthropic/claude-sonnet-4.5
WRITING_MODEL=anthropic/claude-opus-4.8
# "mock" swaps the OpenRouter LLMs for deterministic canned ones (Unit 23 —
# the golden-path E2E's stubbed model). E2E/dev only; a production boot
# (NODE_ENV=production) REFUSES mock outright (Unit 28a guard).
# LLM_MODE=live

# Worker liveness/readiness HTTP surface for platform health checks (Unit 28a).
# GET /health (always 200) and /ready (Temporal worker RUNNING + Postgres).
# WORKER_HEALTH_PORT=4001

# NODE_ENV=production hardens boot: the dev-default BETTER_AUTH_SECRET and
# PLATFORM_ENCRYPTION_KEY (and LLM_MODE=mock) are refused with a named error
# (Unit 28a). Deployment env matrix: infra/DEPLOY.md.

# --- Platform secrets ---
# AES-256-GCM platform key for encrypting per-org OpenRouter API keys at rest
# (Unit 11). The server encrypts with it; the worker decrypts with the SAME key
# (Unit 12) — set it for both processes. 32-byte key, base64-encoded:
# `openssl rand -base64 32`. A dev-only default is baked in for local/tests;
# PRODUCTION MUST set a real key here.
PLATFORM_ENCRYPTION_KEY=

# Org id used by the worker demo scripts (run-pipeline, demo-reliability.sh)
# to start org-scoped runs from the CLI (Unit 12).
CONDUCTOR_ORG_ID=

# Better Auth (Unit 09). Secret min 32 chars: `openssl rand -base64 32`.
# A dev-only default is baked in for local; PRODUCTION MUST set a real secret here.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:4000

# Google OAuth (Unit 09) — sign-in with Google is enabled only when BOTH are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Auth email (OTP verification / sign-in / password reset) uses a dev log transport
# by default (codes print to the server log). A real provider is wired later.

# Web -> server origin for the Better Auth client and API calls (Unit 16).
NEXT_PUBLIC_SERVER_URL=http://localhost:4000
