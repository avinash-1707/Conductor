# Conductor dashboard (Unit 28a).
# Multi-stage: NEXT_PUBLIC_* values are inlined into the client bundle at BUILD
# time, so the image is built per environment with the server URL as an ARG.
# Build from the REPO ROOT:
#   docker build -f Dockerfile.web \
#     --build-arg NEXT_PUBLIC_SERVER_URL=https://api.example.com \
#     -t conductor-web .
FROM node:22-slim AS builder

ENV COREPACK_HOME=/corepack
RUN corepack enable

WORKDIR /app

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml tsconfig.base.json ./
RUN corepack install
COPY apps/web/package.json apps/web/
COPY packages/shared/package.json packages/shared/

RUN pnpm install --frozen-lockfile --filter @conductor/web...

COPY packages/shared packages/shared
COPY apps/web apps/web

ARG NEXT_PUBLIC_SERVER_URL
ENV NEXT_PUBLIC_SERVER_URL=$NEXT_PUBLIC_SERVER_URL
ENV NEXT_TELEMETRY_DISABLED=1
RUN pnpm --filter @conductor/web build

# Runtime: the self-contained standalone server only — no pnpm, no workspace.
FROM node:22-slim AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1

COPY --from=builder --chown=node:node /app/apps/web/.next/standalone ./
COPY --from=builder --chown=node:node /app/apps/web/.next/static ./apps/web/.next/static
COPY --from=builder --chown=node:node /app/apps/web/public ./apps/web/public

ENV PORT=3000
ENV HOSTNAME=0.0.0.0
EXPOSE 3000
USER node

CMD ["node", "apps/web/server.js"]
